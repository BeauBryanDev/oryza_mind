# A template. Vite reads .env, .env.local and .env.<mode>, never this file.
#
# Local dev: leave unset. The app falls back to /api, which vite.config.ts
# proxies to http://localhost:8005.
#
# Vercel: set this in the project env vars (Production and Preview). It is
# inlined at build time, so redeploy after changing it.
# VITE_API_BASE_URL=https://api.oryza.tensorgeek.com
